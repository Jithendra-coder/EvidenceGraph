# Copy to .env for Docker Compose. Keep real secrets out of source control.
EVIDENCEGRAPH_DATA_DIR=./data
EVIDENCEGRAPH_PUBLIC_BASE_URL=https://research.example.com
EVIDENCEGRAPH_ALLOWED_HOSTS=research.example.com
EVIDENCEGRAPH_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
EVIDENCEGRAPH_OIDC_DISCOVERY_URL=https://identity.example.com/.well-known/openid-configuration
EVIDENCEGRAPH_OIDC_CLIENT_ID=replace-with-client-id
EVIDENCEGRAPH_OIDC_CLIENT_SECRET=replace-with-client-secret
EVIDENCEGRAPH_ALLOWED_EMAILS=
EVIDENCEGRAPH_ALLOWED_EMAIL_DOMAINS=example.com
# Optional OpenAI-compatible provider; leave all three blank to keep generation disabled.
EVIDENCEGRAPH_LLM_BASE_URL=
EVIDENCEGRAPH_LLM_MODEL=
EVIDENCEGRAPH_LLM_API_KEY=
EVIDENCEGRAPH_LLM_MAX_TOKENS=1200
